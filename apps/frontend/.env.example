# Token Mapbox public (https://account.mapbox.com/access-tokens/)
# Sans token, la carte affiche un fallback statique.
VITE_MAPBOX_TOKEN=

# Style Mapbox (optionnel). Défaut : mapbox://styles/mapbox/standard (3D + light presets).
# Mets ton style perso ici, ex : mapbox://styles/florianbernier/xxxxxxxx
VITE_MAPBOX_STYLE=
